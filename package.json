{
  "name": "ppaji-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "빠지 타이쿤 — 강변 수상레저 경영 시뮬레이션",
  "scripts": {
    "dev": "npm --prefix ppaji run dev",
    "build": "npm --prefix ppaji run build",
    "preview": "npm --prefix ppaji run preview",
    "sim": "tsx tools/sim-runner.ts",
    "test": "npm --prefix ppaji run test",
    "test:watch": "npm --prefix ppaji run test:watch",
    "lint": "npm --prefix ppaji run lint",
    "typecheck": "npm --prefix ppaji run typecheck",
    "verify": "npm --prefix ppaji run verify",
    "verify:mobile": "tsx tools/verify-mobile.ts",
    "gate": "npm --prefix ppaji run gate",
    "verify:kairo": "tsx tools/verify-kairo.ts --shell-v2 && tsx tools/verify-kairo.ts --course-v2 && tsx tools/verify-kairo.ts --scene-v2 && tsx tools/verify-kairo.ts && tsx tools/seam-qa.ts --selftest",
    "share:kairo": "tsx tools/share-kairo.ts",
    "shot:kairo": "tsx tools/shot-kairo.ts",
    "shot:zoom": "tsx tools/shot-kairo-zoom.ts",
    "sim:kairo": "tsx tools/kairo-sim.ts",
    "seam": "tsx tools/seam-qa.ts",
    "icons": "tsx tools/make-icons.ts",
    "bake:atlas": "tsx tools/bake-kairo-atlas.ts",
    "verify:pwa": "npm run legacy:build && tsx tools/verify-pwa.ts",
    "legacy:dev": "vite",
    "legacy:build": "tsc --noEmit && vite build && tsx tools/gen-precache.ts",
    "legacy:preview": "vite preview",
    "legacy:test": "vitest run",
    "legacy:test:watch": "vitest",
    "legacy:lint": "eslint .",
    "legacy:typecheck": "tsc --noEmit",
    "legacy:verify": "npm run legacy:typecheck && npm run legacy:lint && npm run legacy:test && npm run legacy:gate && npm run sim:kairo -- --determinism",
    "legacy:gate": "tsx tools/kairo-gate.ts && node tools/check-ui-surface.mjs",
    "setup": "npm ci && npm --prefix ppaji ci",
    "serve:main": "node ppaji/tools/serve-dist.mjs 5189"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.0",
    "playwright": "^1.62.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
